@page "/login"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject EncryptionService EncryptionService
@inject SessionService Session
@inject NavigationManager Nav
@using SecureVault.Services

<PageTitle>Log in — SecureVault</PageTitle>

<div class="sv-auth-wrap">
    <div class="sv-auth-card">
        <div class="sv-auth-icon">🔒</div>
        <div class="sv-auth-title">SecureVault</div>
        <div class="sv-auth-sub">Enter your master password to unlock your vault.</div>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <div class="mb-3">
                <label class="form-label">Master password</label>
                <InputText type="password" class="form-control" @bind-Value="_model.Password" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                @(_busy ? "Checking..." : "Unlock Vault")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task HandleSubmit()
    {
        _error = null;
        _busy = true;
        try
        {
            var user = await AuthService.AuthenticateAsync(_model.Password);
            if (user is null)
            {
                _error = "Incorrect master password.";
                return;
            }

            var key = EncryptionService.DeriveKey(_model.Password, user.Salt);
            Session.Login(user, key);
            Nav.NavigateTo("/home");
        }
        finally
        {
            _busy = false;
        }
    }

    private class LoginModel
    {
        public string Password { get; set; } = string.Empty;
    }
}