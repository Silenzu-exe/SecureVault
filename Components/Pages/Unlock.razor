@page "/unlock"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject EncryptionService EncryptionService
@inject SessionService Session
@inject NavigationManager Nav
@using SecureVault.Services

<PageTitle>Locked — SecureVault</PageTitle>

<div class="sv-auth-wrap">
    <div class="sv-auth-card">
        <div class="sv-auth-icon">🔐</div>
        <div class="sv-auth-title">Vault Locked</div>
        <div class="sv-auth-sub">You've been inactive. Re-enter your master password to continue.</div>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <div class="mb-3">
                <InputText type="password" class="form-control" @bind-Value="_model.Password"
                           placeholder="Master password" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                @(_busy ? "Checking..." : "Unlock")
            </button>
        </EditForm>

        <button class="btn btn-outline-light w-100 mt-2" @onclick="LogoutInstead">
            Log out instead
        </button>
    </div>
</div>

@code {
    private readonly UnlockModel _model = new();
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Session.CurrentUser is null)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task HandleSubmit()
    {
        _error = null;

        if (Session.CurrentUser is null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _busy = true;
        try
        {
            var isValid = await AuthService.AuthenticateAsync(_model.Password);
            if (isValid is null)
            {
                _error = "Incorrect master password.";
                return;
            }

            var key = EncryptionService.DeriveKey(_model.Password, Session.CurrentUser.Salt);
            Session.Unlock(key);
            Nav.NavigateTo("/vault");
        }
        finally
        {
            _busy = false;
        }
    }

    private void LogoutInstead()
    {
        Session.Logout();
        Nav.NavigateTo("/login");
    }

    private class UnlockModel
    {
        public string Password { get; set; } = string.Empty;
    }
}